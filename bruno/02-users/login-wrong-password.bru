meta {
  name: login-wrong-password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrongPassword123"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
